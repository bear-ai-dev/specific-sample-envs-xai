{
  "tui-gamepigeon": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/run-with-bun.cjs ./scripts/antigravity-hook.ts --session-start"
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/run-with-bun.cjs ./scripts/antigravity-hook.ts --pre-invocation"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/run-with-bun.cjs ./scripts/antigravity-hook.ts --stop"
      }
    ]
  }
}
