+function tickInterval(current: PlayableGame): number | null {
+  if (!current.tickMs) return null;
+  // 0 is a game saying "hold the clock" — paused, mid-decision, or finished.
+  const interval = current.tickMs();
+  return interval > 0 ? interval : null;
+}
+
+function stopGravity(): void {
+  if (gravityTimer) clearTimeout(gravityTimer);
+  gravityTimer = undefined;
+  workerOrchestrator?.pause();
+}
+
+function scheduleGravity(): void {
+  if (!game || !shouldScheduleTick({ screen, gameOver: game.isOver(), pauseReason })) return;
+  const interval = tickInterval(game);
+  if (interval === null) {
+    workerOrchestrator?.pause();
+    return;
+  }
+  if (workerOrchestrator) {
+    workerOrchestrator.start();
+    return;
+  }
+  // Supersede any pending tick. Several callers (closing the pause prompt,
+  // restoring the window, signing out) resume gravity without stopping it
+  // first, and the timer handle is overwritten rather than cleared — so the
+  // orphaned timeout kept firing and rescheduling itself. Two live loops tick
+  // the game twice per interval instead of once.
+  stopGravity();
+  const current = game;
+  gravityTimer = setTimeout(() => {
+    if (game !== current || !shouldScheduleTick({ screen, gameOver: current.isOver(), pauseReason })) return;
+    performAction("tick");
+    scheduleGravity();
+  }, interval);
+}
