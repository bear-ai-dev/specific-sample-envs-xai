{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tui-gamepigeon.dev/contracts/restaurant-arena-action-v2.schema.json",
  "title": "Restaurant Arena action v2",
  "$comment": "Worker actions and typed player suggestions share this envelope. \"actorType\" distinguishes them; the simulator applies role permissions to worker actions and never treats player text as a direct state mutation. v2 carries the three-role roster and the Inspector's tools: hold, clear_hold, request_verification, verify (answered by the chef or server), escalate, and handoff. Malformed, unauthorized, stale, duplicate, and unsafe actions return an actionError and mutate nothing. No provider, SDK, model name, or prompt format belongs in this contract. Adds the Steward's role and its order_stock tool.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "episodeId",
    "actorId",
    "actorType",
    "role",
    "tool",
    "arguments",
    "tick",
    "timestamp",
    "requestId",
    "idempotencyKey"
  ],
  "properties": {
    "version": {
      "const": "restaurant-arena-action/v2"
    },
    "episodeId": {
      "$ref": "#/$defs/arenaId"
    },
    "actorId": {
      "$ref": "#/$defs/arenaId"
    },
    "actorType": {
      "enum": [
        "worker",
        "player"
      ]
    },
    "role": {
      "enum": [
        "chef",
        "server",
        "inspector",
        "steward"
      ]
    },
    "tool": {
      "enum": [
        "inspect",
        "prepare",
        "serve",
        "seat",
        "update_guest",
        "request_help",
        "send_message",
        "hold",
        "clear_hold",
        "request_verification",
        "verify",
        "escalate",
        "handoff",
        "order_stock"
      ]
    },
    "arguments": {
      "type": "object"
    },
    "tick": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "requestId": {
      "$ref": "#/$defs/arenaId"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,129}$",
      "maxLength": 130
    }
  },
  "$defs": {
    "arenaId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "actionError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "enum": [
            "role_not_permitted",
            "invalid_arguments",
            "unknown_entity",
            "invalid_state",
            "stale_tick",
            "duplicate_request",
            "unsafe_action",
            "episode_complete"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  },
  "x-toolArguments": {
    "$comment": "Per-tool argument shapes the simulator validates before any mutation. Documentation for implementers; the envelope's \"arguments\" stays an open object so a tool can gain a field without a new envelope version. A trailing ? marks an optional argument.",
    "inspect": [
      "subjectKind",
      "subjectId"
    ],
    "hold": [
      "subjectKind",
      "subjectId",
      "reason",
      "evidenceRef"
    ],
    "clear_hold": [
      "holdId"
    ],
    "request_verification": [
      "subjectKind",
      "subjectId",
      "question",
      "targetRole"
    ],
    "verify": [
      "requestId",
      "result",
      "note?"
    ],
    "escalate": [
      "subjectKind",
      "subjectId",
      "reason",
      "uncertainty",
      "evidenceRefs?"
    ],
    "handoff": [
      "summary",
      "evidenceRefs",
      "claimedRisks",
      "claimedSafe"
    ],
    "send_message": [
      "to",
      "text",
      "priority?"
    ],
    "order_stock": [
      "ingredient",
      "quantity"
    ]
  }
}
