+  const replay = root.replay as RestaurantArenaTraceV3["replay"] | undefined;
+  if (!replay || typeof replay.variation !== "string" || !Array.isArray(replay.inputs) || !STATE_HASH_REGEX.test(replay.finalStateHash)) {
