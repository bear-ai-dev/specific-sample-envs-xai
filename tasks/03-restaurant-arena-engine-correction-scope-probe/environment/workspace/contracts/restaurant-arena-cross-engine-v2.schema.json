{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tui-gamepigeon.dev/contracts/restaurant-arena-cross-engine-v2.schema.json",
  "title": "Restaurant Arena cross-engine fixture v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "roles", "scenarios"],
  "properties": {
    "version": { "const": "restaurant-arena-cross-engine/v2" },
    "roles": {
      "const": ["host", "supply_lead", "chef", "server"]
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "allOf": [
        { "contains": { "type": "object", "properties": { "id": { "const": "routine" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "id": { "const": "incident" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "id": { "const": "manager-correction" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "steps"],
        "properties": {
          "id": { "enum": ["routine", "incident", "manager-correction"] },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "tick"],
              "properties": {
                "tick": { "type": "integer", "minimum": 0 },
                "kind": { "enum": ["priority", "advance", "correction"] },
                "role": { "enum": ["host", "supply_lead", "chef", "server"] },
                "orderId": { "type": "string", "minLength": 1 },
                "priority": { "enum": ["normal", "high"] },
                "text": { "type": "string", "minLength": 1 },
                "managerCorrection": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
