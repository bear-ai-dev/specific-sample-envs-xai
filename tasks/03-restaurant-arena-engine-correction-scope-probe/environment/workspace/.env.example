# Cloudflare auth Worker URL (no trailing slash)
# Example: https://tui-gamepigeon-auth.<subdomain>.workers.dev
GAMEPIGEON_AUTH_URL=

# Opaque per-user bearer token issued by Retro Backend. Setting this enables
# gameplay sync.
GAMEPIGEON_BACKEND_TOKEN=

# Sync backend URL. Defaults to https://api.runretroarcade.com when omitted;
# set it only to target local or staging infrastructure.
# GAMEPIGEON_BACKEND_URL=http://127.0.0.1:8787

# Optional product analytics
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
